#, fuzzy
msgid "plugins.generic.blindReviewGuard.displayName"
msgstr "Blind Review Guard"

#, fuzzy
msgid "plugins.generic.blindReviewGuard.description"
msgstr "Ελέγχει τα αρχεία που πρόκειται να λάβει ο αξιολογητής για οτιδήποτε ταυτοποιεί τους συγγραφείς — ιδιότητες εγγράφου, παρακολούθηση αλλαγών, σχόλια, το κείμενο και το όνομα του αρχείου — και μπορεί να αφαιρέσει αυτόματα τα ταυτοποιητικά μεταδεδομένα. Το αρχείο που ανέβασε ο συγγραφέας δεν τροποποιείται ποτέ."

