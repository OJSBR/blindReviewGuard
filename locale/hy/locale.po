#, fuzzy
msgid "plugins.generic.blindReviewGuard.displayName"
msgstr "Blind Review Guard"

#, fuzzy
msgid "plugins.generic.blindReviewGuard.description"
msgstr "Ստուգում է այն ֆայլերը, որոնք գրախոսը պատրաստվում է ստանալ՝ հեղինակներին բացահայտող ամեն ինչի համար՝ փաստաթղթի հատկություններ, հետագծվող փոփոխություններ, մեկնաբանություններ, տեքստ և ֆայլի անուն, և կարող է ինքնաշխատ հեռացնել բացահայտող մետատվյալները. հեղինակի վերբեռնած սկզբնական ֆայլը երբեք չի փոփոխվում։"

