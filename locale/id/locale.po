#, fuzzy
msgid "plugins.generic.blindReviewGuard.displayName"
msgstr "Blind Review Guard"

#, fuzzy
msgid "plugins.generic.blindReviewGuard.description"
msgstr "Memeriksa berkas yang akan diterima mitra bestari untuk mencari apa pun yang mengidentifikasi penulis — properti dokumen, pelacakan perubahan, komentar, teks, dan nama berkas — serta dapat menghapus metadata pengidentifikasi secara otomatis. Berkas asli yang diunggah penulis tidak pernah diubah."

#, fuzzy
msgid "plugins.generic.blindReviewGuard.settings.checks"
msgstr "Pemeriksaan"

#, fuzzy
msgid "plugins.generic.blindReviewGuard.settings.checks.description"
msgstr "Setiap pemeriksaan dapat dimatikan jika menimbulkan gangguan dalam alur kerja Anda."

#, fuzzy
msgid "plugins.generic.blindReviewGuard.settings.checkMetadata"
msgstr "Properti dokumen (penulis, terakhir diubah oleh, perusahaan)"

#, fuzzy
msgid "plugins.generic.blindReviewGuard.settings.checkRevisionMarks"
msgstr "Pelacakan perubahan dan komentar"

#, fuzzy
msgid "plugins.generic.blindReviewGuard.settings.checkText"
msgstr "Nama penulis, alamat surel, dan ORCID iD di dalam teks"

#, fuzzy
msgid "plugins.generic.blindReviewGuard.settings.checkFilename"
