#, fuzzy
msgid "plugins.generic.blindReviewGuard.displayName"
msgstr "Blind Review Guard"

#, fuzzy
msgid "plugins.generic.blindReviewGuard.description"
msgstr "Memeriksa fail yang bakal diterima oleh penilai untuk apa-apa yang mengenal pasti penulis — sifat dokumen, jejak perubahan, komen, teks dan nama fail — serta boleh membuang metadata pengenalan secara automatik. Fail asal yang dimuat naik oleh penulis tidak pernah diubah."

