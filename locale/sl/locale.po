#, fuzzy
msgid "plugins.generic.blindReviewGuard.displayName"
msgstr "Blind Review Guard"

#, fuzzy
msgid "plugins.generic.blindReviewGuard.description"
msgstr "Preveri datoteke, ki jih bo prejel recenzent, glede vsega, kar identificira avtorje — lastnosti dokumenta, sledene spremembe, komentarje, besedilo in ime datoteke — in lahko samodejno odstrani identifikacijske metapodatke. Izvirna datoteka, ki jo je naložil avtor, se nikoli ne spremeni."

